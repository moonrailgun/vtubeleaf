{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Studio events and clean output window controls",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:webview:allow-create-webview-window",
    "core:webview:allow-get-all-webviews",
    "core:window:allow-get-all-windows",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    "core:resources:allow-close",
    "virtual-camera:allow-status",
    "virtual-camera:allow-install",
    "virtual-camera:allow-uninstall",
    "virtual-camera:allow-start",
    "virtual-camera:allow-stop",
    "virtual-camera:allow-submit"
  ]
}
