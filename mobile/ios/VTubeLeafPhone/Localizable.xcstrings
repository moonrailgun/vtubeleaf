            "value": "Ouvrir les réglages système"
          }
        }
      }
    },
    "pause": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止"
          }
        },
        "es": {
