    "support_text_arkit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Head turn, nod and tilt; left and right eye openness; mouth open and smile; gaze, brows, mouth shift, cheek puff and tongue from ARKit face tracking. Hands and the upper body are not tracked on the phone. Smoothing, sensitivity and neutral-pose calibration stay on the computer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "头部左右转、抬头低头、歪头；左右眼睁开程度；张嘴和微笑；以及 ARKit 面部跟踪提供的视线、眉毛、嘴部左右、鼓腮和吐舌。手机不识别双手和上半身。平滑、灵敏度和中立姿态校准都在电脑上完成。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頭の左右の向き、上下、傾き。左右の目の開き具合。口の開きと笑顔。ARKit フェイストラッキングによる視線、眉、口の左右移動、頬の膨らみ、舌。手と上半身はスマートフォンでは認識しません。スムージング、感度、ニュートラル姿勢のキャリブレーションは PC 側で行います。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Giro, inclinación y ladeo de la cabeza; apertura del ojo izquierdo y derecho; boca abierta y sonrisa; mirada, cejas, desplazamiento de la boca, mejillas hinchadas y lengua del seguimiento facial de ARKit. Las manos y la parte superior del cuerpo no se siguen en el teléfono. El suavizado, la sensibilidad y la calibración de la pose neutra se quedan en el equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotation, hochement et inclinaison de la tête ; ouverture des yeux gauche et droit ; bouche ouverte et sourire ; regard, sourcils, décalage de la bouche, joues gonflées et langue via le suivi du visage ARKit. Les mains et le haut du corps ne sont pas suivis sur le téléphone. Le lissage, la sensibilité et le calibrage de la pose neutre restent sur l’ordinateur."
          }
        }
      }
    },
    "support_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What this app sends"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用发送什么"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリが送るもの"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué envía esta app"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que cette app envoie"
          }
        }
      }
    },
    "thermal_paused": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracking paused to protect the phone from overheating. Let it cool down, then press Resume."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为防止手机过热，已暂停跟踪。等手机降温后点「继续」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過熱を防ぐためトラッキングを一時停止しました。冷えてから「再開」を押してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguimiento en pausa para proteger el teléfono del sobrecalentamiento. Deja que se enfríe y pulsa Reanudar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivi mis en pause pour protéger le téléphone de la surchauffe. Laissez-le refroidir, puis appuyez sur Reprendre."
          }
        }
      }
    },
    "thermal_warning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone is getting hot and may slow down. A short break or better airflow helps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机正在发热，可能会降速。可以稍作休息或改善散热。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンが熱くなっており、速度が落ちることがあります。少し休ませるか、放熱を良くしてください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teléfono se está calentando y puede ir más lento. Un descanso breve o mejor ventilación ayudan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléphone chauffe et peut ralentir. Une courte pause ou une meilleure aération aide."
          }
        }
      }
    },
