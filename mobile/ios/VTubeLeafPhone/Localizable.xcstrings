    "network_intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a direct connection on your local network is used — no account, no internet service."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只会在局域网内直接连接电脑，不需要账号，也不经过互联网。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルネットワーク内で PC に直接接続するだけです。アカウントもインターネットサービスも使いません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se usa una conexión directa en tu red local: sin cuenta y sin servicios de internet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule une connexion directe sur votre réseau local est utilisée : ni compte, ni service internet."
          }
        }
      }
    },
    "open_system_settings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open system settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开系统设置"
          }
        },
        "ja": {
          "stringUnit": {
