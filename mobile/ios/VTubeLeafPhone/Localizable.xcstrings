          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Langue"
          }
        }
      }
    },
    "language_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS keeps the app language in Settings → VTubeLeaf → Language."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 在「设置 → VTubeLeaf → 语言」中管理应用语言。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの言語は iOS の「設定 → VTubeLeaf → 言語」で切り替えます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS guarda el idioma de la app en Ajustes → VTubeLeaf → Idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS gère la langue de l’app dans Réglages → VTubeLeaf → Langue."
          }
        }
      }
    },
    "link_ended": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已断开。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切断しました。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecté."
          }
        }
      }
    },
    "link_identity": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The computer’s identity did not match the code. Scan the code shown on the computer again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑身份与二维码不一致。请重新扫描电脑上显示的二维码。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PC の識別情報が QR コードと一致しません。PC に表示されている QR コードをもう一度スキャンしてください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La identidad del equipo no coincide con el código. Vuelve a escanear el código que muestra el equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’identité de l’ordinateur ne correspond pas au code. Scannez à nouveau le code affiché sur l’ordinateur."
          }
        }
      }
    },
    "link_lost": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection could not be restored within 30 seconds. Tracking was paused."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "30 秒内没有恢复连接，已暂停跟踪。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30 秒以内に接続を復旧できませんでした。トラッキングを一時停止しました。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo recuperar la conexión en 30 segundos. El seguimiento se puso en pausa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion n’a pas pu être rétablie en 30 secondes. Le suivi a été mis en pause."
          }
        }
      }
    },
    "link_unreachable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not reach the computer. Check that both devices are on the same Wi-Fi, that the network does not isolate devices (guest mode), and that the computer’s firewall allows VTubeLeaf."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连上电脑。请确认两台设备在同一个 Wi-Fi、网络没有隔离设备（访客模式），并且电脑的防火墙允许 VTubeLeaf。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PC に接続できません。両方の端末が同じ Wi-Fi にあること、ネットワークが端末を分離していないこと（ゲストモード）、PC のファイアウォールが VTubeLeaf を許可していることを確認してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo llegar al equipo. Comprueba que ambos dispositivos estén en la misma Wi-Fi, que la red no aísle los dispositivos (modo invitado) y que el cortafuegos del equipo permita VTubeLeaf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre l’ordinateur. Vérifiez que les deux appareils sont sur le même Wi-Fi, que le réseau n’isole pas les appareils (mode invité) et que le pare-feu de l’ordinateur autorise VTubeLeaf."
          }
        }
      }
    },
    "local_network_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also check Settings → VTubeLeaf → Local Network is allowed; without it the computer can’t be reached."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另请确认「设置 → VTubeLeaf → 本地网络」已允许，否则无法连上电脑。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定 → VTubeLeaf → ローカルネットワーク」が許可されているかも確認してください。許可がないと PC に接続できません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba también que Ajustes → VTubeLeaf → Red local esté permitido; sin ello no se puede llegar al equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez aussi que Réglages → VTubeLeaf → Réseau local est autorisé ; sans cela l’ordinateur est injoignable."
          }
        }
      }
    },
    "nav_connect": {
      "localizations": {
