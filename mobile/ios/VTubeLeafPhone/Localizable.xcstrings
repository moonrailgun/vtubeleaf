    "paused_background": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused while the app was in the background. Press Resume to continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用切到后台时已暂停。点「继续」恢复。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリがバックグラウンドにあったため一時停止しました。「再開」を押して続けてください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa mientras la app estaba en segundo plano. Pulsa Reanudar para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mis en pause pendant que l’app était en arrière-plan. Appuyez sur Reprendre pour continuer."
          }
        }
      }
    },
    "paused_interrupted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused because the camera was interrupted (a call or another app). Press Resume to continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头被系统中断（来电或其他应用），已暂停。点「继续」恢复。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラが中断されたため（着信や他のアプリ）一時停止しました。「再開」を押して続けてください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa porque la cámara fue interrumpida (una llamada u otra app). Pulsa Reanudar para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mis en pause car la caméra a été interrompue (un appel ou une autre app). Appuyez sur Reprendre pour continuer."
          }
        }
      }
    },
    "preview_hidden": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview hidden · the camera is still tracking"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览已隐藏 · 摄像头仍在跟踪"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビュー非表示 · カメラは引き続きトラッキング中"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa oculta · la cámara sigue funcionando"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu masqué · la caméra continue le suivi"
          }
        }
      }
    },
    "privacy_text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera image stays on this phone. Only head rotation, eye, mouth and expression values are sent to your computer over your local network, and only after you scan its pairing code. Nothing is stored or uploaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头画面只留在这台手机上。只有头部转动、眼睛、嘴部和表情数值会通过局域网发到你的电脑，并且只在你扫描电脑的配对二维码之后。不保存、不上传任何内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラ映像はこのスマートフォンの中に留まります。PC に送るのは頭の回転、目、口、表情の数値だけで、PC のペアリング用 QR コードをスキャンした後にローカルネットワーク経由で送ります。保存もアップロードもしません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen de la cámara se queda en este teléfono. Solo se envían a tu equipo, por la red local, los valores de rotación de la cabeza, ojos, boca y expresión, y solo después de escanear su código de emparejamiento. No se guarda ni se sube nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’image de la caméra reste sur ce téléphone. Seules les valeurs de rotation de la tête, des yeux, de la bouche et des expressions sont envoyées à votre ordinateur par le réseau local, et seulement après avoir scanné son code d’appairage. Rien n’est enregistré ni téléversé."
          }
        }
      }
    },
    "privacy_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐私"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライバシー"
          }
        },
        "es": {
