    "hide_preview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide preview"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏预览"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューを隠す"
