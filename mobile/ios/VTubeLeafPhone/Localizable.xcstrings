          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confidentialité"
          }
        }
      }
    },
    "qr_invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is not a VTubeLeaf pairing code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是 VTubeLeaf 的配对二维码。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは VTubeLeaf のペアリングコードではありません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso no es un código de emparejamiento de VTubeLeaf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n’est pas un code d’appairage VTubeLeaf."
          }
        }
      }
    },
    "qr_version %lld %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code needs another app version (code version %1$lld, this app supports %2$lld). Update the phone app and the desktop app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个二维码需要另一个版本的应用（二维码版本 %1$lld，本应用支持 %2$lld）。请同时更新手机应用和桌面应用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この QR コードには別のバージョンのアプリが必要です（コードのバージョン %1$lld、このアプリの対応バージョン %2$lld）。スマートフォンアプリとデスクトップアプリの両方を更新してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código necesita otra versión de la app (versión del código %1$lld; esta app admite %2$lld). Actualiza la app del teléfono y la de escritorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code nécessite une autre version de l’app (version du code %1$lld, cette app prend en charge %2$lld). Mettez à jour l’app du téléphone et l’app de bureau."
          }
        }
      }
    },
    "reconnecting": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection lost · reconnecting…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接中断 · 正在重连…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続が切れました · 再接続中…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexión perdida · reconectando…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion perdue · reconnexion…"
          }
        }
      }
    },
    "reject_busy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The computer already has a phone connected. Click “Disconnect phone” on the computer, then scan the new code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑已经连接了另一台手机。请在电脑上点「断开手机」，再扫描新的二维码。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PC にはすでに別のスマートフォンが接続されています。PC で「スマートフォンを切断」を押してから、新しい QR コードをスキャンしてください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El equipo ya tiene un teléfono conectado. Haz clic en “Desconectar teléfono” en el equipo y escanea el código nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un téléphone est déjà connecté à l’ordinateur. Cliquez sur « Déconnecter le téléphone » sur l’ordinateur, puis scannez le nouveau code."
          }
        }
      }
    },
    "reject_data": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The computer rejected the data this app sent. Update both apps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑拒绝了本应用发送的数据，请同时更新两端应用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリが送ったデータを PC が拒否しました。両方のアプリを更新してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El equipo rechazó los datos que envió esta app. Actualiza ambas apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ordinateur a rejeté les données envoyées par cette app. Mettez à jour les deux apps."
          }
        }
      }
    },
    "reject_session": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The computer ended this session. Scan the new code to pair again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑已结束这次连接。扫描新的二维码即可重新配对。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PC がこのセッションを終了しました。新しい QR コードをスキャンすると再度ペアリングできます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El equipo cerró esta sesión. Escanea el código nuevo para emparejar otra vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ordinateur a terminé cette session. Scannez le nouveau code pour appairer à nouveau."
          }
        }
      }
    },
    "reject_token": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code has expired. Click “Disconnect phone” or restart tracking on the computer and scan the new code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个二维码已失效。请在电脑上点「断开手机」或重新开始跟踪，再扫描新的二维码。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この QR コードは期限切れです。PC で「スマートフォンを切断」を押すかトラッキングを再開し、新しい QR コードをスキャンしてください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código ha caducado. Haz clic en “Desconectar teléfono” o reinicia el seguimiento en el equipo y escanea el código nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code a expiré. Cliquez sur « Déconnecter le téléphone » ou relancez le suivi sur l’ordinateur, puis scannez le nouveau code."
          }
        }
      }
    },
    "reject_version": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The desktop app uses another protocol version. Update both apps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
