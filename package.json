{
  "name": "vtubeleaf",
  "version": "0.1.8",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run licenses:check && tsc --noEmit && vite build",
    "licenses:generate": "node scripts/licenses.mjs --generate",
    "licenses:check": "node scripts/licenses.mjs",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "npm run build && playwright test",
    "tauri": "tauri",
    "release": "release-it --ci",
    "release:patch": "npm run release -- patch",
    "release:minor": "npm run release -- minor",
    "setup:assets": "node scripts/setup-assets.mjs",
    "setup:openseeface": "node scripts/setup-openseeface.mjs"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore(release): ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": false
    },
    "hooks": {
      "after:bump": "node scripts/sync-version.mjs && npm run licenses:generate"
    }
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "@pixi/unsafe-eval": "^6.5.10",
    "@tauri-apps/api": "2.11.1",
    "@vtubeleaf/cubism-core": "file:vendor/vtubeleaf-cubism-core-5.0.0-r.4.tgz",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gifuct-js": "^2.1.2",
    "lucide-react": "^1.42.0",
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "6.5.10",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "overrides": {
    "gh-pages": "^6.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "3.9.6",
    "release-it": "^21.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "7.3.6"
  }
}
